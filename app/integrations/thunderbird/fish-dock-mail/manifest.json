{
  "manifest_version": 2,
  "name": "FISH Dock Mail",
  "description": "New mail in FISH Dock island: the unread count, and the island opens for a new letter.",
  "version": "1.0",
  "author": "FISH Dock",
  "homepage_url": "https://github.com/Fish-under-sea/FISH-Dock",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail@fish-dock",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["accountsRead", "messagesRead", "http://127.0.0.1/*"]
}
